{
  "name": "videosummarizer",
  "version": "1.0.0",
  "description": "VideoSummarizer Web App",
  "main": "index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "npm start --prefix api",
    "install:all": "npm install && npm install --prefix client && npm install --prefix api",
    "build:client": "npm run build --prefix client",
    "build": "cd client && npm install && npx vite build",
    "vercel-build": "cd client && npm install && npx vite build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.1",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "groq-sdk": "^0.3.3",
    "youtube-transcript": "^1.3.1"
  }
}
